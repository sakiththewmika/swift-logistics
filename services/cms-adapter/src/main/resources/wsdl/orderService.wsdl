<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:tns="http://swiftlogistics.com/cms/orders"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  targetNamespace="http://swiftlogistics.com/cms/orders">

    <wsdl:types>
        <xsd:schema targetNamespace="http://swiftlogistics.com/cms/orders" elementFormDefault="qualified">
            <xsd:element name="SubmitOrderRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="orderId" type="xsd:string"/>
                        <xsd:element name="clientId" type="xsd:string"/>
                        <xsd:element name="amount" type="xsd:double"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="SubmitOrderResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="status" type="xsd:string"/>
                        <xsd:element name="message" type="xsd:string"/>
                        <xsd:element name="orderId" type="xsd:string"/>
                        <xsd:element name="billedAmount" type="xsd:double"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="CancelInvoiceRequest"><xsd:complexType><xsd:sequence><xsd:element name="orderId" type="xsd:string"/></xsd:sequence></xsd:complexType></xsd:element>
            <xsd:element name="CancelInvoiceResponse"><xsd:complexType><xsd:sequence><xsd:element name="status" type="xsd:string"/><xsd:element name="message" type="xsd:string"/><xsd:element name="orderId" type="xsd:string"/></xsd:sequence></xsd:complexType></xsd:element>
            <xsd:element name="CancelOrderBillingRequest"><xsd:complexType><xsd:sequence><xsd:element name="orderId" type="xsd:string"/></xsd:sequence></xsd:complexType></xsd:element>
            <xsd:element name="CancelOrderBillingResponse"><xsd:complexType><xsd:sequence><xsd:element name="status" type="xsd:string"/><xsd:element name="message" type="xsd:string"/><xsd:element name="orderId" type="xsd:string"/></xsd:sequence></xsd:complexType></xsd:element>
        </xsd:schema>
    </wsdl:types>

    <wsdl:message name="SubmitOrderRequest">
        <wsdl:part name="parameters" element="tns:SubmitOrderRequest"/>
    </wsdl:message>

    <wsdl:message name="SubmitOrderResponse">
        <wsdl:part name="parameters" element="tns:SubmitOrderResponse"/>
    </wsdl:message>
    <wsdl:message name="CancelInvoiceRequest"><wsdl:part name="parameters" element="tns:CancelInvoiceRequest"/></wsdl:message>
    <wsdl:message name="CancelInvoiceResponse"><wsdl:part name="parameters" element="tns:CancelInvoiceResponse"/></wsdl:message>
    <wsdl:message name="CancelOrderBillingRequest"><wsdl:part name="parameters" element="tns:CancelOrderBillingRequest"/></wsdl:message>
    <wsdl:message name="CancelOrderBillingResponse"><wsdl:part name="parameters" element="tns:CancelOrderBillingResponse"/></wsdl:message>

    <wsdl:portType name="OrderPortType">
        <wsdl:operation name="SubmitOrder">
            <wsdl:input message="tns:SubmitOrderRequest"/>
            <wsdl:output message="tns:SubmitOrderResponse"/>
        </wsdl:operation>
        <wsdl:operation name="CancelInvoice"><wsdl:input message="tns:CancelInvoiceRequest"/><wsdl:output message="tns:CancelInvoiceResponse"/></wsdl:operation>
        <wsdl:operation name="CancelOrderBilling"><wsdl:input message="tns:CancelOrderBillingRequest"/><wsdl:output message="tns:CancelOrderBillingResponse"/></wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="OrderBinding" type="tns:OrderPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="SubmitOrder">
            <soap:operation soapAction=""/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
        <wsdl:operation name="CancelInvoice"><soap:operation soapAction=""/><wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output></wsdl:operation>
        <wsdl:operation name="CancelOrderBilling"><soap:operation soapAction=""/><wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output></wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="OrderService">
        <wsdl:documentation>Mock CMS Order Service</wsdl:documentation>
        <wsdl:port name="OrderPort" binding="tns:OrderBinding">
            <soap:address location="http://localhost:8081/ws"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>